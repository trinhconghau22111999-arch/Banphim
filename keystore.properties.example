# Copy this file to "keystore.properties" (project root, same folder as
# this file) and fill in the real values to sign local release builds in
# Android Studio. "keystore.properties" itself is git-ignored - never
# commit your real passwords.
#
# storeFile is relative to the project root.
storeFile=keystore/key.qr.banphim.jks
storePassword=PASTE_KEYSTORE_PASSWORD_HERE
keyAlias=key.qr.banphim
keyPassword=PASTE_KEY_PASSWORD_HERE
